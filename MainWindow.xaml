<Window x:Class="LANMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Health &amp; Peripheral Monitor" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Network Status Dashboard" 
                   FontSize="24" FontWeight="SemiBold" 
                   Foreground="#2F3640" Margin="0,0,0,20"/>

        <!-- Device Data Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  Background="White" BorderBrush="#DCDDE1" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="2*"/>
                <DataGridTextColumn Header="Avg Latency (ms)" Binding="{Binding MovingAverageMs, StringFormat={}{0:F1} ms}" Width="1.5*"/>

                <!-- Status Column with dynamic styling -->
                <DataGridTemplateColumn Header="State" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="10,2" Margin="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Online">
                                                <Setter Property="Background" Value="#E3FCEF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Degraded">
                                                <Setter Property="Background" Value="#FFFAE6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Offline">
                                                <Setter Property="Background" Value="#FFEBE6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentState}" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Add Peripheral" 
            Command="{Binding AddDeviceCommand}" 
            Width="120" Height="35" Margin="0,0,10,0"/>
            <Button Content="Export Logs" Width="120" Height="35"/>
        </StackPanel>
    </Grid>
</Window>