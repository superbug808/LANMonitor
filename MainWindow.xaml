<Window x:Class="LANMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="LAN Health &amp; Peripheral Monitor" Height="720" Width="950"
        MinHeight="650" MinWidth="800">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: Header -->
            <RowDefinition Height="*"/>
            <!-- Row 1: Devices DataGrid -->
            <RowDefinition Height="220"/>
            <!-- Row 2: Live Latency Chart -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Action Buttons Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <TextBlock Text="LAN Health &amp; Peripheral Monitor" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12" Grid.Row="0"/>

        <!-- 1. Monitored Devices DataGrid -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Devices}" 
                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  SelectionMode="Single"
                  Background="White" BorderBrush="#DCDDE1" BorderThickness="1"
                  Margin="0,0,0,10">
            <!-- Right-Click Context Menu for Direct Row Actions -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Run Traceroute" Command="{Binding ViewTracerouteCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="IP Address" Binding="{Binding IpAddress}" Width="2*"/>
                <DataGridTextColumn Header="Avg Latency (ms)" Binding="{Binding MovingAverageMs, StringFormat={}{0:F1} ms}" Width="1.5*"/>
                <DataGridTextColumn Header="24h Uptime" Binding="{Binding UptimePercentage, StringFormat={}{0:F1}%}" Width="1.2*"/>

                <DataGridTemplateColumn Header="State" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="10,2" Margin="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Online">
                                                <Setter Property="Background" Value="#E3FCEF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Degraded">
                                                <Setter Property="Background" Value="#FFFAE6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentState}" Value="Offline">
                                                <Setter Property="Background" Value="#FFEBE6"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentState}" HorizontalAlignment="Center" FontWeight="Medium"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 2. Live Latency Chart Panel -->
        <Border Grid.Row="2" Margin="0,0,0,12" BorderBrush="#DCDDE1" BorderThickness="1" CornerRadius="4" Padding="10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding SelectedDevice.Name, StringFormat='Real-Time Latency Trend: {0}', FallbackValue='Select a device above to view live latency trend'}" 
                           FontWeight="SemiBold" Margin="0,0,0,5" Foreground="#333333"/>

                <lvc:CartesianChart Grid.Row="1"
                                    Series="{Binding LatencySeries}"
                                    YAxes="{Binding YAxes}"/>
            </Grid>
        </Border>

        <!-- 3. Bottom Control Bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Width="100" Height="32" Margin="0,0,10,0"/>
            <Button Content="Run Traceroute" Command="{Binding ViewTracerouteCommand}" Width="120" Height="32" Margin="0,0,10,0"/>
            <Button Content="Add Peripheral" Command="{Binding AddDeviceCommand}" Width="120" Height="32" Margin="0,0,10,0"/>
            <Button Content="Delete Peripheral" Command="{Binding DeleteDeviceCommand}" Width="120" Height="32" Margin="0,0,10,0" Background="#FF5252" Foreground="White"/>
            <Button Content="Export Logs" Command="{Binding ExportLogsCommand}" Width="120" Height="32"/>
        </StackPanel>
    </Grid>
</Window>